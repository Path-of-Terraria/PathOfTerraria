MapCommon: {
	// PlaceOnDevice: Place this on a Map Device to use it
	// BossUses: Can be used a certain amount of times depending on player count
	/* BossBase:
		'''
		{$PlaceOnDevice}
		{$BossUses}
		''' */
}

// SigilCommon.Usage: Place in an unlocked Map Device sigil slot; consumed when the portal opens

CarvedSigilOfBinding: {
	// DisplayName: Carved Sigil of Binding
	// Tooltip: Adds 1 Runebound prison to an explorable map
}

GildedSigilOfBinding: {
	// DisplayName: Gilded Sigil of Binding
	// Tooltip: Adds 2 Runebound prisons; rewards have a 15% chance to upgrade one grade
}

